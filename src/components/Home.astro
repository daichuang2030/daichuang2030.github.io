---
import { Image } from 'astro:assets';
import { ArrowUpRight, Linkedin, BookOpen, MoveDown } from 'lucide-astro';
import portrait from '../assets/peter-portrait.png';
import Layout from '../layouts/Layout.astro';
import { copy, links, notePath, type Locale } from '../data/site';
import { essays } from '../data/essays';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const featured = essays[0];
---
<Layout locale={locale}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-intro"><span class="intro-line" aria-hidden="true"></span>{t.introduction}</p>
      <h1 id="hero-title">{t.heroLines.map((line) => <span>{line}</span>)}</h1>
      <p class="hero-bio">{t.heroBio}</p>
      <div class="hero-actions"><a class="button button-primary" href="#perspectives">{t.primary}<ArrowUpRight size={18}/></a><a class="quiet-link" href="#about">{t.secondary}<MoveDown size={17}/></a></div>
    </div>
    <figure class="hero-portrait">
      <div class="portrait-frame"><Image src={portrait} alt={t.portraitAlt} widths={[400, 640, 796]} sizes="(max-width: 680px) 90vw, (max-width: 1000px) 44vw, 470px" width={796} height={1024} format="webp" quality={88} loading="eager" fetchpriority="high" /></div>
      <figcaption><span class="caption-rule" aria-hidden="true"></span><div><strong>Peter DAI Chuang</strong><span>{t.role}</span><span>{t.role2}</span></div></figcaption>
    </figure>
  </section>
  <div class="principle-band container"><p>{t.principle}</p><div class="profile-links" aria-label={locale === 'en' ? 'Public profiles' : '公开主页'}><a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<ArrowUpRight size={14}/></a><a href={links.openreview} target="_blank" rel="noopener noreferrer">OpenReview<ArrowUpRight size={14}/></a><a href={links.orcid} target="_blank" rel="noopener noreferrer">ORCID<ArrowUpRight size={14}/></a></div></div>

  <section id="about" data-observe class="about-section section container" aria-labelledby="about-title">
    <div class="section-side"><p class="section-label">{t.aboutLabel}</p><h2 id="about-title">{t.aboutTitle}</h2><div class="about-prose">{t.aboutParagraphs.map((p) => <p>{p}</p>)}</div><a class="text-link" href={links.linkedin} target="_blank" rel="noopener noreferrer">{t.careerLink}<ArrowUpRight size={17}/></a></div>
    <div class="career-notes">
      <article><span class="note-label">{t.current}</span><h3>{t.currentTitle}</h3><p>{t.currentText}</p><a class="small-link" href={links.hkstp} target="_blank" rel="noopener noreferrer">{t.source}<ArrowUpRight size={14}/></a></article>
      <article><span class="note-label">{t.experience}</span><h3>{t.experienceTitle}</h3><p>{t.experienceText}</p></article>
      <article><span class="note-label">{t.education}</span><h3>{t.educationTitle}</h3><p>{t.educationText}</p></article>
    </div>
  </section>

  <section id="practice" data-observe class="practice-section" aria-labelledby="practice-title">
    <div class="container practice-inner">
      <div class="practice-heading"><p class="section-label">{t.practiceLabel}</p><h2 id="practice-title">{t.practiceTitle.split('\n').map((line) => <span>{line}</span>)}</h2><p>{t.practiceIntro}</p></div>
      <div class="practice-workspace" data-practice>
        <div class="lens-control"><div class="lens-tabs" role="tablist" aria-label={t.practiceInstructions}>{t.lenses.map((lens, index) => <button type="button" role="tab" id={`tab-${lens.id}`} aria-controls={`panel-${lens.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-index={index}>{lens.label}<ArrowUpRight size={16}/></button>)}</div>
        {t.lenses.map((lens, index) => <div id={`panel-${lens.id}`} class="lens-panel" role="tabpanel" aria-labelledby={`tab-${lens.id}`} tabindex="0" hidden={index !== 0}><h3>{lens.title}</h3><p>{lens.body}</p><ul class="lens-tags">{lens.tags.map((tag) => <li>{tag}</li>)}</ul></div>)}
        </div>
        <div class="practice-diagram" aria-hidden="true">
          <svg viewBox="0 0 480 340" class="diagram-lines"><ellipse cx="240" cy="182" rx="167" ry="130"/><ellipse cx="240" cy="182" rx="125" ry="83"/><path d="M240 46v85M80 266l109-60M400 266l-109-60"/><circle cx="240" cy="182" r="58"/></svg>
          <div class="diagram-node node-top" data-node="0">{t.lenses[0].diagram[0]}</div><div class="diagram-node node-left" data-node="1">{t.lenses[0].diagram[1]}</div><div class="diagram-node node-right" data-node="2">{t.lenses[0].diagram[2]}</div><div class="diagram-center">{t.diagramCenter.split('\n').map((line) => <span>{line}</span>)}</div>
          <script type="application/json" id="diagram-labels" set:html={JSON.stringify(t.lenses.map(lens => lens.diagram))} />
        </div>
      </div>
    </div>
  </section>

  <section id="perspectives" data-observe class="perspectives-section section container" aria-labelledby="perspectives-title">
    <div class="section-header"><div><p class="section-label">{t.perspectivesLabel}</p><h2 id="perspectives-title">{t.perspectivesTitle}</h2></div><p>{t.perspectivesIntro}</p></div>
    <div class="essay-grid">
      <a class="featured-essay" href={notePath(locale, featured.slug)}>
        <div class="essay-art" aria-hidden="true"><svg viewBox="0 0 620 300"><defs><pattern id="grid" width="34" height="34" patternUnits="userSpaceOnUse"><path d="M34 0H0V34" fill="none" stroke="#d3deed" stroke-width="1"/></pattern></defs><rect width="620" height="300" fill="url(#grid)"/><g transform="translate(180 40)"><path d="M0 145 95 92 95 170 0 223Z" fill="#8daaf2"/><path d="m95 92 93 53v78l-93-53Z" fill="#244edb"/><path d="m0 145 95-53 93 53-93 53Z" fill="#cad8fc"/><path d="m95 92 93-53 95 53-95 54Z" fill="#b0c5fc"/><path d="m95 92 93 54v77l-93-53Z" fill="#244edb"/><path d="m188 146 95-54v78l-95 53Z" fill="#557bed"/><path d="m188 39 94-53 96 53-95 53Z" fill="#e0e9ff"/><path d="m188 39 95 53v78l-95-54Z" fill="#87a5f2"/><path d="m283 92 95-53v78l-95 53Z" fill="#244edb"/></g></svg><span class="art-caption">{locale === 'en' ? 'Ideas, built into the world.' : '让想法，成为现实的一部分。'}</span></div>
        <div class="featured-body"><div class="essay-meta"><span>{featured.topic[locale]}</span><span>{featured.readTime[locale]}</span></div><h3>{featured.title[locale]}</h3><p>{featured.excerpt[locale]}</p><span class="text-link">{t.readEssay}<ArrowUpRight size={18}/></span></div>
      </a>
      <div class="essay-stack">{essays.slice(1).map((essay) => <a class="compact-essay" href={notePath(locale, essay.slug)}><div class="essay-meta"><span>{essay.topic[locale]}</span><span>{essay.readTime[locale]}</span></div><h3>{essay.title[locale]}</h3><p>{essay.excerpt[locale]}</p><span class="compact-read">{t.readEssay}<ArrowUpRight size={18}/></span></a>)}</div>
    </div>
    <p class="editorial-disclosure">{locale === 'en' ? 'These three essays are original editorial drafts prepared for this website.' : '以上三篇为本网站准备的原创观点草稿。'}</p>
    <a class="published-writing" href="https://www.linkedin.com/pulse/ai-productivity-starting-point-financial-result-peter-chuang-dai-rjpsc/" target="_blank" rel="noopener noreferrer"><BookOpen size={24}/><div><span>{locale === 'en' ? 'From my LinkedIn newsletter' : '来自我的 LinkedIn 专栏'}</span><h3>{locale === 'en' ? 'AI productivity is a starting point, not a financial result' : 'AI 生产力只是起点，尚不等于财务结果'}</h3></div><ArrowUpRight size={23}/></a>
  </section>

  <section class="public-section container" aria-labelledby="public-title"><div class="public-title"><p class="section-label">{t.publicLabel}</p><h2 id="public-title">{t.publicTitle}</h2></div><div class="public-list">{t.publicItems.map((item) => <a class="public-item" href={item.url} target="_blank" rel="noopener noreferrer"><span class="public-type">{item.type}</span><div><h3>{item.title}</h3><p>{item.detail}</p><span class="public-source">{item.source}</span></div><ArrowUpRight size={21}/></a>)}</div></section>

  <section class="research-section section container" aria-labelledby="research-title"><div class="research-symbol" aria-hidden="true"><svg viewBox="0 0 240 240"><circle cx="120" cy="120" r="83"/><ellipse cx="120" cy="120" rx="38" ry="83" transform="rotate(45 120 120)"/><ellipse cx="120" cy="120" rx="38" ry="83" transform="rotate(-45 120 120)"/><circle cx="120" cy="120" r="9" class="research-dot"/><circle cx="180" cy="62" r="6" class="research-dot"/></svg></div><div><p class="section-label">{t.researchLabel}</p><h2 id="research-title">{t.researchTitle.split('\n').map((line) => <span>{line}</span>)}</h2><p class="research-copy">{t.researchText}</p><div class="research-links"><a class="text-link" href={links.openreview} target="_blank" rel="noopener noreferrer">OpenReview<ArrowUpRight size={17}/></a><a class="text-link" href={links.orcid} target="_blank" rel="noopener noreferrer">ORCID<ArrowUpRight size={17}/></a></div></div></section>

  <section class="beyond-section" aria-labelledby="beyond-title"><div class="container beyond-inner"><div><p class="section-label">{t.beyondLabel}</p><h2 id="beyond-title">{t.beyondTitle.split('\n').map((line) => <span>{line}</span>)}</h2><p>{t.beyondText}</p></div><div class="personal-belief"><span class="belief-mark" aria-hidden="true">“</span><p>{t.beyondQuote}</p><span class="belief-signature">Peter DAI Chuang</span></div></div></section>

  <section id="connect" data-observe class="connect-section section container" aria-labelledby="connect-title"><div><p class="section-label">{t.connectLabel}</p><h2 id="connect-title">{t.connectTitle.split('\n').map((line) => <span>{line}</span>)}</h2></div><div class="connect-content"><p>{t.connectText}</p><a class="button button-primary" href={links.linkedin} target="_blank" rel="noopener noreferrer"><Linkedin size={17}/>{t.connectButton}<ArrowUpRight size={18}/></a><a class="quiet-link" href={links.x} target="_blank" rel="noopener noreferrer">{t.follow}<ArrowUpRight size={16}/></a></div></section>
</Layout>
<script>
  const practice = document.querySelector<HTMLElement>('[data-practice]');
  const tabs = [...(practice?.querySelectorAll<HTMLButtonElement>('[role="tab"]') || [])];
  const panels = [...(practice?.querySelectorAll<HTMLElement>('[role="tabpanel"]') || [])];
  const labels: string[][] = JSON.parse(document.getElementById('diagram-labels')?.textContent || '[]');
  function activate(index: number, focus = false) {
    tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
    panels.forEach((panel, i) => { panel.hidden = i !== index; });
    practice?.querySelectorAll('[data-node]').forEach((node, i) => { node.textContent = labels[index]?.[i] || ''; });
    if (focus) tabs[index]?.focus();
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activate(index));
    tab.addEventListener('keydown', (event) => {
      const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : event.key === 'ArrowLeft' ? (index - 1 + tabs.length) % tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : -1;
      if (next < 0) return;
      event.preventDefault(); activate(next, true);
    });
  });
</script>
